# Which provider a run talks to: deepseek (default) or ollama.
PROOFCODER_PROVIDER=deepseek

# DeepSeek. Read only when PROOFCODER_PROVIDER is deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=high

# Local model through Ollama. Read only when PROOFCODER_PROVIDER is ollama.
# No credential is needed; OLLAMA_MODEL has no default because the installed set is yours.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
